# Copy to .env and replace every CHANGE_ME value before use.

VF_ENV=development
VF_API_HOST=0.0.0.0
VF_API_PORT=8000
VF_LOG_LEVEL=INFO
VF_CORS_ORIGINS=http://localhost:8080

POSTGRES_DB=venturefoundry
POSTGRES_USER=venturefoundry
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://venturefoundry:CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD@db:5432/venturefoundry

# JWT validation. HS256 is provided for the controlled foundation.
# Replace with an external IdP/JWKS integration before institutional rollout.
VF_JWT_ALGORITHM=HS256
VF_JWT_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
VF_JWT_AUDIENCE=venturefoundry-api
VF_JWT_ISSUER=pefy-gg-identity

# Local development only. MUST be false in shared, pilot and production environments.
VF_DEV_AUTH_ENABLED=true
VF_DEV_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000101
VF_DEV_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
VF_DEV_DEFAULT_ROLES=executive_sponsor,portfolio_admin,risk_manager,auditor

VF_REQUEST_TIMEOUT_SECONDS=30
VF_DB_POOL_MIN=2
VF_DB_POOL_MAX=10
